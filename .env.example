# ---- Browser settings (safe to expose; used by the web app) ----
# Supabase → Project Settings → API (or "Connect"):
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# The anon / publishable key (NOT the service_role / secret key)
VITE_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# Leave both Supabase values empty to run the offline DEMO mode
# (data stays in this browser only; admin password "demo"; teachers just pick their name).

# ---- Setup-only settings (NEVER prefix these with VITE_) ----
# Used only by `npm run db:setup` on your computer. Not needed on Vercel.
# Supabase → Connect → "Session pooler" connection string:
SUPABASE_DB_URL=postgresql://postgres.YOUR-PROJECT:YOUR-DB-PASSWORD@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres
# Admin page password (at least 8 characters, use something long):
ADMIN_PASSWORD=change-me-to-a-long-password
